@model ToyStore.Models.ShoppingCart

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-shopping-cart"></i> Giỏ hàng của tôi</h2>
        <div class="d-flex align-items-center">
            <span class="badge bg-primary fs-6 me-3">
                <i class="fas fa-box"></i> @Model.ItemCount sản phẩm
            </span>
            <a href="/" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Tiếp tục mua sắm
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Items.Any())
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Danh sách sản phẩm</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.Items)
                        {
                            <div class="row align-items-center py-3 border-bottom">
                                <div class="col-md-2">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid rounded" style="max-height: 80px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 80px;">
                                            <i class="fas fa-image text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">@item.ProductName</h6>
                                    <p class="text-success mb-0 fw-bold">@item.Price.ToString("N0") ₫</p>
                                </div>
                                <div class="col-md-3">
                                    <form action="/Cart/Update" method="post" class="d-flex align-items-center">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="changeQuantity(@item.ProductId, @item.Quantity - 1)">-</button>
                                        <input type="number" id="quantity-@item.ProductId" value="@item.Quantity" min="1" max="999" class="form-control text-center mx-2" style="width: 60px;" readonly />
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="changeQuantity(@item.ProductId, @item.Quantity + 1)">+</button>
                                    </form>
                                </div>
                                <div class="col-md-2">
                                    <p class="text-success mb-0 fw-bold">@item.Total.ToString("N0") ₫</p>
                                </div>
                                <div class="col-md-1">
                                    <form action="/Cart/Remove" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa sản phẩm">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Tóm tắt đơn hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span>@Model.Total.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển:</span>
                            <span class="text-success">Miễn phí</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Tổng cộng:</strong>
                            <strong class="text-success">@Model.Total.ToString("N0") ₫</strong>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="/Cart/Checkout" class="btn btn-success btn-lg">
                                <i class="fas fa-credit-card"></i> Thanh toán
                            </a>
                            <form action="/Cart/Clear" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?')">
                                    <i class="fas fa-trash"></i> Xóa giỏ hàng
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-4x text-muted mb-4"></i>
            <h4 class="text-muted">Giỏ hàng trống</h4>
            <p class="text-muted">Hãy thêm sản phẩm vào giỏ hàng để tiếp tục mua sắm</p>
            <a href="/" class="btn btn-primary btn-lg">
                <i class="fas fa-shopping-bag"></i> Mua sắm ngay
            </a>
        </div>
    }
</div>

<style>
/* Cart Page Styles */
.container {
    color: #fff;
}

.cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.8), rgba(10, 10, 10, 0.8));
    border: 2px solid #00ff88;
    border-radius: 1rem;
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
}

.cart-header h2 {
    color: #00ff88;
    font-weight: 800;
    margin: 0;
    text-shadow: 0 0 10px rgba(0, 255, 136, 0.3);
}

.cart-header h2 i {
    margin-right: 0.5rem;
}

.badge {
    background: rgba(0, 255, 136, 0.1) !important;
    border: 2px solid #00ff88 !important;
    color: #00ff88 !important;
    font-weight: 600;
}

.btn-outline-primary {
    background: linear-gradient(135deg, #00ff88, #00ffff);
    color: #000 !important;
    border: none;
    font-weight: 600;
}

.btn-outline-primary:hover {
    background: linear-gradient(135deg, #00ffff, #00ff88);
    transform: translateY(-2px);
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
    color: #000 !important;
}

.card {
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(10, 10, 10, 0.9)) !important;
    border: 2px solid #00ff88 !important;
    border-radius: 1rem !important;
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.3) !important;
}

.card-header {
    background: linear-gradient(135deg, #00ff88, #00ffff) !important;
    color: #000 !important;
    font-weight: 700;
    border-bottom: none !important;
}

.card-body {
    color: #fff !important;
}

.card-body h6 {
    color: #fff !important;
}

.card-body p {
    color: #00ff88 !important;
}

.btn-outline-secondary {
    background: rgba(0, 255, 136, 0.1);
    border: 1px solid #00ff88;
    color: #00ff88;
}

.btn-outline-secondary:hover {
    background: #00ff88;
    color: #000;
    border-color: #00ff88;
}

.btn-outline-danger {
    background: rgba(255, 107, 107, 0.1);
    border: 1px solid #ff6b6b;
    color: #ff6b6b;
}

.btn-outline-danger:hover {
    background: #ff6b6b;
    color: #fff;
    border-color: #ff6b6b;
}

.btn-success {
    background: linear-gradient(135deg, #00ff88, #00ffff) !important;
    color: #000 !important;
    border: none !important;
    font-weight: 600;
}

.btn-success:hover {
    background: linear-gradient(135deg, #00ffff, #00ff88) !important;
    transform: translateY(-2px);
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
    color: #000 !important;
}

.btn-primary {
    background: linear-gradient(135deg, #00ff88, #00ffff) !important;
    color: #000 !important;
    border: none !important;
    font-weight: 600;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #00ffff, #00ff88) !important;
    transform: translateY(-2px);
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
    color: #000 !important;
}

.text-success {
    color: #00ff88 !important;
}

.text-muted {
    color: #b0b0ff !important;
}

.border-bottom {
    border-bottom: 1px solid rgba(0, 255, 136, 0.3) !important;
}

hr {
    border-color: rgba(0, 255, 136, 0.3) !important;
}

.form-control {
    background: rgba(26, 26, 46, 0.8) !important;
    border: 1px solid #00ff88 !important;
    color: #fff !important;
}

.form-control:focus {
    background: rgba(26, 26, 46, 0.9) !important;
    border-color: #00ffff !important;
    box-shadow: 0 0 10px rgba(0, 255, 136, 0.4) !important;
    color: #fff !important;
}

.alert-success {
    background: rgba(0, 255, 136, 0.1) !important;
    border: 1px solid #00ff88 !important;
    color: #00ff88 !important;
}

.alert-danger {
    background: rgba(255, 107, 107, 0.1) !important;
    border: 1px solid #ff6b6b !important;
    color: #ff6b6b !important;
}

/* Empty cart styling */
.text-center.py-5 {
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.8), rgba(10, 10, 10, 0.8));
    border: 2px solid #00ff88;
    border-radius: 1rem;
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
    padding: 3rem !important;
}

.text-center.py-5 i {
    color: #00ff88 !important;
    font-size: 4rem !important;
}

.text-center.py-5 h4 {
    color: #fff !important;
}

.text-center.py-5 p {
    color: #b0b0ff !important;
}

/* Responsive */
@@media (max-width: 768px) {
    .cart-header {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
    }
    
    .d-flex.align-items-center {
        flex-direction: column;
        gap: 1rem;
    }
}
</style>

<script>
function changeQuantity(productId, newQuantity) {
    if (newQuantity < 1) return;
    
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/Cart/Update';
    
    var productIdInput = document.createElement('input');
    productIdInput.type = 'hidden';
    productIdInput.name = 'productId';
    productIdInput.value = productId;
    
    var quantityInput = document.createElement('input');
    quantityInput.type = 'hidden';
    quantityInput.name = 'quantity';
    quantityInput.value = newQuantity;
    
    form.appendChild(productIdInput);
    form.appendChild(quantityInput);
    document.body.appendChild(form);
    form.submit();
}
</script>
