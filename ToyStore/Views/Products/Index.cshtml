@model IEnumerable<ToyStore.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-box"></i> Quản lý sản phẩm</h2>
    <a href="/Products/Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Thêm sản phẩm mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="fas fa-image me-2"></i>Hình ảnh</th>
                            <th><i class="fas fa-box me-2"></i>Tên sản phẩm</th>
                            <th><i class="fas fa-tags me-2"></i>Danh mục</th>
                            <th><i class="fas fa-dollar-sign me-2"></i>Giá</th>
                            <th><i class="fas fa-warehouse me-2"></i>Tồn kho</th>
                            <th><i class="fas fa-toggle-on me-2"></i>Trạng thái</th>
                            <th><i class="fas fa-cogs me-2"></i>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="product-thumbnail" />
                                    }
                                    else
                                    {
                                        <div class="product-thumbnail-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <strong>@item.ProductName</strong>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <br><small class="text-muted">@(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.Category.CategoryName</span>
                                </td>
                                <td>
                                    <strong class="text-success">@item.Price.ToString("N0") ₫</strong>
                                </td>
                                <td>
                                    <span class="badge @(item.Stock > 10 ? "bg-success" : item.Stock > 0 ? "bg-warning" : "bg-danger")">
                                        @item.Stock
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == true)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>Đang bán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-pause-circle me-1"></i>Ngừng bán
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="/Products/Details/@item.ProductId" class="btn btn-sm btn-info" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="/Products/Edit/@item.ProductId" class="btn btn-sm btn-warning" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/Products/Delete/@item.ProductId" class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-box fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Chưa có sản phẩm nào</h5>
                <p class="text-muted">Hãy thêm sản phẩm đầu tiên</p>
                <a href="/Products/Create" class="btn btn-primary">Thêm sản phẩm</a>
            </div>
        }
    </div>
</div>

<style>
    .product-thumbnail {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 0.5rem;
        border: 2px solid #00ff88;
    }

    .product-thumbnail-placeholder {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, rgba(26, 26, 46, 0.8), rgba(10, 10, 10, 0.8));
        border: 2px solid #00ff88;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #00ff88;
        font-size: 1.2rem;
    }

    .table th {
        border-top: none;
        font-weight: 600;
        background: linear-gradient(135deg, #1a1a2e, #0a0a0a) !important;
        color: #00ff88 !important;
    }

    .table td {
        vertical-align: middle;
        color: #fff !important;
    }

    .table-striped > tbody > tr:nth-of-type(odd) > td {
        background-color: rgba(26, 26, 46, 0.3) !important;
    }

    .table-hover > tbody > tr:hover > td {
        background-color: rgba(0, 255, 136, 0.1) !important;
    }

    .btn-group .btn {
        margin-right: 2px;
    }

    .btn-group .btn:last-child {
        margin-right: 0;
    }

    .card {
        background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(10, 10, 10, 0.9)) !important;
        border: 2px solid #00ff88 !important;
        border-radius: 1rem !important;
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.3) !important;
    }

    .card-body {
        color: #fff !important;
    }

    .alert-success {
        background: rgba(0, 255, 136, 0.1) !important;
        border: 1px solid #00ff88 !important;
        color: #00ff88 !important;
    }

    .alert-danger {
        background: rgba(255, 107, 107, 0.1) !important;
        border: 1px solid #ff6b6b !important;
        color: #ff6b6b !important;
    }

    .btn-primary {
        background: linear-gradient(135deg, #00ff88, #00ffff) !important;
        color: #000 !important;
        border: none !important;
        font-weight: 600;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #00ffff, #00ff88) !important;
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
        color: #000 !important;
    }

    .btn-info {
        background: rgba(0, 255, 255, 0.1) !important;
        border: 1px solid #00ffff !important;
        color: #00ffff !important;
    }

    .btn-info:hover {
        background: #00ffff !important;
        color: #000 !important;
        border-color: #00ffff !important;
    }

    .btn-warning {
        background: rgba(255, 193, 7, 0.1) !important;
        border: 1px solid #ffc107 !important;
        color: #ffc107 !important;
    }

    .btn-warning:hover {
        background: #ffc107 !important;
        color: #000 !important;
        border-color: #ffc107 !important;
    }

    .btn-danger {
        background: rgba(255, 107, 107, 0.1) !important;
        border: 1px solid #ff6b6b !important;
        color: #ff6b6b !important;
    }

    .btn-danger:hover {
        background: #ff6b6b !important;
        color: #fff !important;
        border-color: #ff6b6b !important;
    }

    .text-success {
        color: #00ff88 !important;
    }

    .text-muted {
        color: #b0b0ff !important;
    }

    .badge {
        font-weight: 600;
    }
</style>