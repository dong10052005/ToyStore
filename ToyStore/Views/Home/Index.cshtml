@model IEnumerable<ToyStore.Models.Category>
@{
    ViewData["Title"] = "Trang chủ";
    var user = ViewBag.User as ToyStore.Models.UserSession;
}

<div class="text-center">
    <h1 class="display-4">Chào mừng đến với ToyStore</h1>
    
    <!-- Search Bar -->
    <div class="container mb-4">
        <form method="get" action="/Home" class="row g-3 justify-content-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text" style="background: rgba(26, 26, 46, 0.9); border: 2px solid #00ff88; color: #00ff88;">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" name="searchName" value="@ViewBag.SearchName" 
                           class="form-control search-input-home" 
                           placeholder="Tìm kiếm sản phẩm..." />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-2"></i>Tìm kiếm
                    </button>
                    @if (!string.IsNullOrEmpty((string)ViewBag.SearchName))
                    {
                        <a href="/Home" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i> Xóa
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
    
    @if (user != null)
    {
        <!-- Toast Notification Container -->
        <div class="toast-notification-container"></div>
        
        <!-- Welcome Alert (only shown once) -->
        <div class="alert alert-success welcome-alert" role="alert" style="display: none;">
            <h4 class="alert-heading">Xin chào, @user.FullName!</h4>
            <p>Bạn đã đăng nhập với tư cách <strong>@user.UserType</strong></p>
            <hr>
            <p class="mb-0">Chúc bạn mua sắm vui vẻ!</p>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Chào mừng!</h4>
            <p>Hãy <a asp-controller="Auth" asp-action="Login" class="alert-link">đăng nhập</a> hoặc <a asp-controller="Auth" asp-action="Register" class="alert-link">đăng ký</a> để trải nghiệm đầy đủ các tính năng của cửa hàng.</p>
        </div>
    }
    
    <!-- Section hiển thị sản phẩm theo danh mục -->
    <div class="mt-5">
        <h2 class="mb-4">Sản phẩm theo danh mục</h2>
        @if (Model != null && Model.Any())
        {
            @foreach (var category in Model)
            {
                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="text-primary">
                            <i class="fas fa-tags me-2"></i>@category.CategoryName
                        </h3>
                        <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-primary btn-sm">
                            Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                    
                    @if (category.Products.Any())
                    {
                        <div class="row">
                            @foreach (var product in category.Products.Take(6))
                            {
                                <div class="col-md-4 col-lg-2 mb-4">
                                    <div class="card h-100 product-card" style="cursor: pointer;" onclick="location.href='@Url.Action("ProductDetails", "Home", new { id = product.ProductId })'">
                                        <div class="position-relative">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.ProductName" style="height: 200px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                                    <i class="fas fa-image fa-3x text-muted"></i>
                                                </div>
                                            }
                                            @if (product.Stock == 0)
                                            {
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge bg-danger">Hết hàng</span>
                                                </div>
                                            }
                                            else if (product.Stock <= 5)
                                            {
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge bg-warning">Sắp hết hàng</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="card-body d-flex flex-column">
                                            <h6 class="card-title">@product.ProductName</h6>
                                            <p class="card-text text-muted small">@category.CategoryName</p>
                                            <p class="card-text text-primary fw-bold">@product.Price.ToString("N0") VNĐ</p>
                                            <div class="mt-auto">
                                                @if (user != null && user.UserType == "Customer")
                                                {
                                                    <div class="d-grid gap-2">
                                                        @if (product.Stock > 0)
                                                        {
                                                            <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline" onclick="event.stopPropagation();">
                                                                <input type="hidden" name="productId" value="@product.ProductId" />
                                                                <input type="hidden" name="quantity" value="1" />
                                                                <button type="submit" class="btn btn-primary btn-sm w-100">Thêm vào giỏ</button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-secondary btn-sm w-100" disabled>
                                                                <i class="fas fa-times me-1"></i>Hết hàng
                                                            </button>
                                                        }
                                                        <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm" onclick="event.stopPropagation();">Xem chi tiết</a>
                                                    </div>
                                                }
                                                else if (user != null && user.UserType != "Customer")
                                                {
                                                    <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm w-100" onclick="event.stopPropagation();">Xem chi tiết</a>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm w-100" onclick="event.stopPropagation();">Xem chi tiết</a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        @if (category.Products.Count() > 6)
                        {
                            <div class="text-center mt-3">
                                <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-secondary btn-sm">
                                    Xem thêm @(category.Products.Count() - 6) sản phẩm khác
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-light" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            Chưa có sản phẩm nào trong danh mục này.
                        </div>
                    }
                </div>
            }
            
            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-primary btn-lg">
                    <i class="fas fa-store me-2"></i>Xem tất cả sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">Chưa có sản phẩm nào!</h4>
                <p>Hiện tại cửa hàng chưa có sản phẩm nào. Vui lòng quay lại sau.</p>
            </div>
        }
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .product-card .btn {
            transition: all 0.2s ease-in-out;
        }

    /* Fix text color in product cards */
    .product-card {
        background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(10, 10, 10, 0.9)) !important;
        border: 2px solid #00ff88 !important;
        border-radius: 1rem !important;
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.3) !important;
        color: #fff !important;
    }

    .product-card .card-title {
        color: #fff !important;
    }

    .product-card .card-text {
        color: #b0b0ff !important;
    }

    .product-card .text-primary {
        color: #00ff88 !important;
    }

    .product-card .text-muted {
        color: #b0b0ff !important;
    }

    .product-card .btn-primary {
        background: linear-gradient(135deg, #00ff88, #00ffff) !important;
        color: #000 !important;
        border: none !important;
        font-weight: 600;
    }

    .product-card .btn-primary:hover {
        background: linear-gradient(135deg, #00ffff, #00ff88) !important;
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
        color: #000 !important;
    }

    .product-card .btn-outline-primary {
        background: rgba(0, 255, 136, 0.1) !important;
        border: 1px solid #00ff88 !important;
        color: #00ff88 !important;
    }

    .product-card .btn-outline-primary:hover {
        background: #00ff88 !important;
        color: #000 !important;
        border-color: #00ff88 !important;
    }

    .product-card .btn-secondary {
        background: rgba(108, 117, 125, 0.1) !important;
        border: 1px solid #6c757d !important;
        color: #6c757d !important;
    }

    .product-card .badge {
        font-weight: 600;
    }

    .product-card .bg-light {
        background: rgba(26, 26, 46, 0.8) !important;
        color: #b0b0ff !important;
    }

    .search-input-home {
        background: rgba(26, 26, 46, 0.9) !important;
        border: 2px solid #00ff88 !important;
        border-left: none !important;
        color: #fff !important;
        padding: 0.75rem 1rem;
    }

    .search-input-home::placeholder {
        color: rgba(255, 255, 255, 0.5) !important;
    }

    .search-input-home:focus {
        background: rgba(26, 26, 46, 1) !important;
        border-color: #00ffff !important;
        box-shadow: 0 0 10px rgba(0, 255, 255, 0.3) !important;
        outline: none;
        color: #fff !important;
    }

    .input-group-text {
        border-right: none !important;
        border-radius: 0.5rem 0 0 0.5rem !important;
    }

    .search-input-home {
        border-radius: 0 0.5rem 0.5rem 0 !important;
    }

    .btn-outline-secondary {
        background: rgba(108, 117, 125, 0.1) !important;
        border: 2px solid #6c757d !important;
        color: #6c757d !important;
        font-weight: 600;
    }

    .btn-outline-secondary:hover {
        background: #6c757d !important;
        color: #fff !important;
        border-color: #6c757d !important;
    }

    /* Toast Notification Styles */
    .toast-notification-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10000;
        max-width: 400px;
    }

    .toast-notification {
        background: linear-gradient(135deg, rgba(0, 255, 136, 0.95), rgba(0, 255, 255, 0.95));
        border: 2px solid #00ff88;
        border-radius: 1rem;
        box-shadow: 0 0 30px rgba(0, 255, 136, 0.5);
        padding: 1.5rem;
        margin-bottom: 1rem;
        animation: slideInRight 0.5s ease-out, fadeOut 0.8s ease-in 4s forwards;
        transform-origin: top right;
        min-width: 300px;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(400px);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOut {
        to {
            opacity: 0;
            transform: translateX(400px);
        }
    }

    .toast-notification .toast-content h4 {
        color: #000;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .toast-notification .toast-content p {
        color: #000;
        margin-bottom: 0.25rem;
        font-size: 0.95rem;
    }

    .toast-notification .toast-content hr {
        border-color: rgba(0, 0, 0, 0.2);
        margin: 0.5rem 0;
    }

    .toast-notification .toast-content .toast-icon {
        font-size: 2rem;
        margin-right: 0.5rem;
        color: #000;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Check if user is logged in and redirected from login
        var userLoggedIn = @(user != null ? "true" : "false");
        
        // Check if there's a flag in session to show the toast
        var showWelcomeToast = '@TempData["ShowWelcomeToast"]' || sessionStorage.getItem('showWelcomeToast');
        
        if (userLoggedIn && showWelcomeToast) {
            // Clear the flag in browser storage so it doesn't show again
            sessionStorage.removeItem('showWelcomeToast');
            
            setTimeout(function() {
                // Create toast notification
                var toastContainer = document.querySelector('.toast-notification-container');
                if (toastContainer) {
                    var toast = document.createElement('div');
                    toast.className = 'toast-notification';
                    
                    var userName = '@Html.Raw(user?.FullName ?? "")';
                    var userType = '@Html.Raw(user?.UserType ?? "")';
                    
                    toast.innerHTML = `
                        <div class="toast-content">
                            <h4><i class="fas fa-check-circle toast-icon"></i>Đăng nhập thành công!</h4>
                            <p>Xin chào, ${userName}!</p>
                            <p>Bạn đã đăng nhập với tư cách <strong>${userType}</strong></p>
                            <hr style="margin: 0.5rem 0;">
                            <p class="mb-0" style="font-weight: 600;">Chúc bạn mua sắm vui vẻ!</p>
                        </div>
                    `;
                    
                    toastContainer.appendChild(toast);
                    
                    // Remove toast from DOM after animation completes (4s + 0.8s fade out)
                    setTimeout(function() {
                        if (toast && toast.parentNode) {
                            toast.remove();
                        }
                    }, 4800);
                }
            }, 300);
        }
    });
</script>
