@model IEnumerable<ToyStore.Models.Category>

@{
    ViewData["Title"] = "Cửa hàng";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-store"></i> Cửa hàng đồ chơi</h2>
        <div class="d-flex align-items-center gap-2">
            <a href="/Cart" class="btn btn-primary">
                <i class="fas fa-shopping-cart"></i> Giỏ hàng
                <span class="badge bg-light text-dark ms-1" id="cart-count">0</span>
            </a>
            <a href="/Order/MyOrders" class="btn btn-outline-primary">
                <i class="fas fa-receipt"></i> Đơn hàng của tôi
            </a>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="card mb-4" style="background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(10, 10, 10, 0.9)); border: 2px solid #00ff88; border-radius: 1rem;">
        <div class="card-body">
            <form method="get" action="/Home/Shop" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" style="color: #00ff88; font-weight: 600;">
                        <i class="fas fa-search me-2"></i>Tìm kiếm sản phẩm
                    </label>
                    <input type="text" name="searchName" value="@ViewBag.SearchName" 
                           class="form-control search-input-shop" 
                           placeholder="Nhập tên sản phẩm..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="color: #00ff88; font-weight: 600;">
                        <i class="fas fa-tags me-2"></i>Lọc theo danh mục
                    </label>
                    <select name="categoryId" class="form-select category-select-shop">
                        <option value="0">-- Tất cả danh mục --</option>
                        @if (ViewBag.Categories != null)
                        {
                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.CategoryId" selected="@(ViewBag.CategoryId != null && ViewBag.CategoryId == category.CategoryId)">
                                    @category.CategoryName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="d-flex gap-2 w-100">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fas fa-search me-2"></i>Tìm kiếm
                        </button>
                        @if (!string.IsNullOrEmpty((string)ViewBag.SearchName) || (ViewBag.CategoryId != null && (int)ViewBag.CategoryId > 0))
                        {
                            <a href="/Home/Shop" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Xóa bộ lọc
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var category in Model)
        {
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="text-primary">
                        <i class="fas fa-tags me-2"></i>@category.CategoryName
                        <span class="badge bg-primary ms-2">@category.Products.Count() sản phẩm</span>
                    </h3>
                </div>
                
                @if (category.Products.Any())
                {
                    <div class="row">
                        @foreach (var product in category.Products)
                        {
                            <div class="col-md-4 col-lg-3 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="position-relative">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" alt="@product.ProductName" class="card-img-top" style="height: 200px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                                <div class="text-center">
                                                    <i class="fas fa-image fa-3x text-muted mb-2"></i>
                                                    <p class="text-muted">Chưa có hình ảnh</p>
                                                </div>
                                            </div>
                                        }
                                        @if (product.Stock <= 0)
                                        {
                                            <div class="position-absolute top-0 end-0 m-2">
                                                <span class="badge bg-danger">Hết hàng</span>
                                            </div>
                                        }
                                        else if (product.Stock <= 10)
                                        {
                                            <div class="position-absolute top-0 end-0 m-2">
                                                <span class="badge bg-warning">Sắp hết hàng</span>
                                            </div>
                                        }
                                    </div>
                                    
                                    <div class="card-body d-flex flex-column">
                                        <div class="mb-2">
                                            <span class="badge bg-secondary">@category.CategoryName</span>
                                        </div>
                                        
                                        <h5 class="card-title">@product.ProductName</h5>
                                        
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <p class="card-text text-muted small">
                                                @(product.Description.Length > 100 ? product.Description.Substring(0, 100) + "..." : product.Description)
                                            </p>
                                        }
                                        
                                        <div class="mt-auto">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="h5 text-success mb-0">@product.Price.ToString("N0") ₫</span>
                                                <small class="text-muted">Còn: @product.Stock</small>
                                            </div>
                                            
                                            <div class="d-grid gap-2">
                                                <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-outline-info btn-sm">
                                                    <i class="fas fa-eye"></i> Xem chi tiết
                                                </a>
                                                
                                                @if (product.Stock > 0)
                                                {
                                                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                                        <input type="hidden" name="productId" value="@product.ProductId" />
                                                        <input type="hidden" name="quantity" value="1" />
                                                        <button type="submit" class="btn btn-success btn-sm w-100">
                                                            <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-secondary btn-sm w-100" disabled>
                                                        <i class="fas fa-times"></i> Hết hàng
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        Chưa có sản phẩm nào trong danh mục này.
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-store fa-4x text-muted mb-4"></i>
            <h4 class="text-muted">Chưa có sản phẩm nào</h4>
            <p class="text-muted">Cửa hàng đang cập nhật sản phẩm mới</p>
        </div>
    }
</div>

<script>
// Load cart count
function loadCartCount() {
    fetch('/Cart/GetCount')
        .then(response => response.json())
        .then(data => {
            document.getElementById('cart-count').textContent = data.count;
        })
        .catch(error => {
            console.log('Error loading cart count:', error);
        });
}

// Load cart count on page load
document.addEventListener('DOMContentLoaded', function() {
    loadCartCount();
});
</script>

<style>
