    background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(10, 10, 10, 0.9)) !important;
    border: 2px solid #00ff88 !important;
    border-radius: 1rem !important;
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.3) !important;
    color: #fff !important;
}

.card .card-title {
    color: #fff !important;
}

.card .card-text {
    color: #b0b0ff !important;
}

.card .text-primary {
    color: #00ff88 !important;
}

.card .text-muted {
    color: #b0b0ff !important;
}

.card .text-success {
    color: #00ff88 !important;
}

.card .btn-outline-info {
    background: rgba(0, 255, 255, 0.1) !important;
    border: 1px solid #00ffff !important;
    color: #00ffff !important;
}

.card .btn-outline-info:hover {
    background: #00ffff !important;
    color: #000 !important;
    border-color: #00ffff !important;
}

.card .btn-success {
    background: linear-gradient(135deg, #00ff88, #00ffff) !important;
    color: #000 !important;
    border: none !important;
    font-weight: 600;
}

.card .btn-success:hover {
    background: linear-gradient(135deg, #00ffff, #00ff88) !important;
    transform: translateY(-2px);
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
    color: #000 !important;
}

.card .btn-secondary {
    background: rgba(108, 117, 125, 0.1) !important;
    border: 1px solid #6c757d !important;
    color: #6c757d !important;
}

.card .bg-light {
    background: rgba(26, 26, 46, 0.8) !important;
    color: #b0b0ff !important;
}

.card .badge {
    font-weight: 600;
}

.btn-primary {
    background: linear-gradient(135deg, #00ff88, #00ffff) !important;
    color: #000 !important;
    border: none !important;
    font-weight: 600;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #00ffff, #00ff88) !important;
    transform: translateY(-2px);
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
    color: #000 !important;
}

.btn-outline-primary {
    background: rgba(0, 255, 136, 0.1) !important;
    border: 1px solid #00ff88 !important;
    color: #00ff88 !important;
}

.btn-outline-primary:hover {
    background: #00ff88 !important;
    color: #000 !important;
    border-color: #00ff88 !important;
}

.text-muted {
    color: #b0b0ff !important;
}

.text-center.py-5 {
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.8), rgba(10, 10, 10, 0.8));
    border: 2px solid #00ff88;
    border-radius: 1rem;
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
    padding: 3rem !important;
}

.text-center.py-5 i {
    color: #00ff88 !important;
    font-size: 4rem !important;
}

.text-center.py-5 h4 {
    color: #fff !important;
}

.text-center.py-5 p {
    color: #b0b0ff !important;
}

.search-input-shop,
.category-select-shop {
    background: rgba(26, 26, 46, 0.9) !important;
    border: 2px solid #00ff88 !important;
    border-radius: 0.5rem !important;
    color: #fff !important;
    padding: 0.5rem 1rem;
}

.search-input-shop::placeholder {
    color: rgba(255, 255, 255, 0.5) !important;
}

.search-input-shop:focus,
.category-select-shop:focus {
    background: rgba(26, 26, 46, 1) !important;
    border-color: #00ffff !important;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.3) !important;
    outline: none;
}

.category-select-shop {
    cursor: pointer;
}

.category-select-shop option {
    background: #1a1a2e !important;
    color: #fff !important;
}

.gap-2 {
    gap: 0.5rem !important;
}

.form-label {
    color: #00ff88 !important;
}

.card .card-body {
    color: #fff !important;
}
</style>
