@model IEnumerable<ToyStore.Models.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tags me-2"></i> Quản lý danh mục</h2>
    <div class="d-flex align-items-center gap-3">
        <form asp-action="Index" method="get" class="d-flex align-items-center">
            <div class="search-container">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
                       class="form-control search-input" placeholder="Tìm kiếm danh mục..." />
                <button type="submit" class="btn btn-outline-primary search-btn">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i> Thêm danh mục mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card categories-main-card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover categories-table">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="fas fa-hashtag me-2"></i>ID</th>
                            <th><i class="fas fa-tag me-2"></i>Tên danh mục</th>
                            <th><i class="fas fa-box me-2"></i>Số sản phẩm</th>                           
                            <th><i class="fas fa-cogs me-2"></i>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="category-row">
                                <td>
                                    <span class="badge bg-primary category-id-badge">#@item.CategoryId</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="category-icon me-3">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <div>
                                            <strong class="category-name">@item.CategoryName</strong>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info product-count-badge">@item.Products.Count() sản phẩm</span>
                                </td>
                                
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-sm btn-info" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 categories-empty-state">
                <i class="fas fa-tags categories-empty-icon"></i>
                <h5 class="categories-empty-title">Chưa có danh mục nào</h5>
                <p class="categories-empty-text">Hãy thêm danh mục đầu tiên để bắt đầu quản lý sản phẩm</p>
                <a asp-action="Create" class="btn btn-primary categories-empty-btn">
                    <i class="fas fa-plus me-2"></i>Thêm danh mục
                </a>
            </div>
        }
    </div>
</div>

<style>
    /* Categories Page Styles */
    .categories-main-card {
        background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(10, 10, 10, 0.9)) !important;
        border: 2px solid #00ff88 !important;
        border-radius: 1rem !important;
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.3) !important;
        color: #fff !important;
    }

    .categories-table th {
        border-top: none;
        font-weight: 600;
        background: linear-gradient(135deg, #1a1a2e, #0a0a0a) !important;
        color: #00ff88 !important;
        padding: 1rem 0.75rem;
        font-size: 0.95rem;
    }

    .categories-table td {
        vertical-align: middle;
        color: #fff !important;
        padding: 1rem 0.75rem;
        border-color: rgba(0, 255, 136, 0.1) !important;
    }

    .category-row {
        transition: all 0.3s ease;
    }

    .category-row:hover {
        background-color: rgba(0, 255, 136, 0.1) !important;
        transform: translateX(5px);
    }

    .table-striped > tbody > tr:nth-of-type(odd) > td {
        background-color: rgba(26, 26, 46, 0.3) !important;
    }

    .category-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #00ff88, #00ffff);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #000;
        font-weight: bold;
        font-size: 1rem;
        box-shadow: 0 0 10px rgba(0, 255, 136, 0.3);
    }

    .category-name {
        color: #fff !important;
        font-weight: 600;
        font-size: 1rem;
    }

    .category-date {
        color: #b0b0ff !important;
        font-size: 0.9rem;
    }

    .category-id-badge,
    .product-count-badge {
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.5rem 0.75rem;
    }

    .btn-group .btn {
        margin-right: 3px;
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
    }

    .btn-group .btn:last-child {
        margin-right: 0;
    }

    .btn-info {
        background: rgba(0, 255, 255, 0.1) !important;
        border: 1px solid #00ffff !important;
        color: #00ffff !important;
    }

    .btn-info:hover {
        background: #00ffff !important;
        color: #000 !important;
        border-color: #00ffff !important;
        transform: translateY(-2px);
        box-shadow: 0 0 10px rgba(0, 255, 255, 0.4);
    }

    .btn-warning {
        background: rgba(255, 193, 7, 0.1) !important;
        border: 1px solid #ffc107 !important;
        color: #ffc107 !important;
    }

    .btn-warning:hover {
        background: #ffc107 !important;
        color: #000 !important;
        border-color: #ffc107 !important;
        transform: translateY(-2px);
        box-shadow: 0 0 10px rgba(255, 193, 7, 0.4);
    }

    .btn-danger {
        background: rgba(255, 107, 107, 0.1) !important;
        border: 1px solid #ff6b6b !important;
        color: #ff6b6b !important;
    }

    .btn-danger:hover {
        background: #ff6b6b !important;
        color: #fff !important;
        border-color: #ff6b6b !important;
        transform: translateY(-2px);
        box-shadow: 0 0 10px rgba(255, 107, 107, 0.4);
    }

    .btn-primary {
        background: linear-gradient(135deg, #00ff88, #00ffff) !important;
        color: #000 !important;
        border: none !important;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.75rem 1.5rem;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #00ffff, #00ff88) !important;
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
        color: #000 !important;
    }

    .alert-success {
        background: rgba(0, 255, 136, 0.1) !important;
        border: 2px solid #00ff88 !important;
        color: #00ff88 !important;
        border-radius: 0.75rem;
    }

    .alert-danger {
        background: rgba(255, 107, 107, 0.1) !important;
        border: 2px solid #ff6b6b !important;
        color: #ff6b6b !important;
        border-radius: 0.75rem;
    }

    .categories-empty-state {
        background: linear-gradient(135deg, rgba(26, 26, 46, 0.8), rgba(10, 10, 10, 0.8));
        border: 2px solid #00ff88;
        border-radius: 1rem;
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
        padding: 4rem 2rem !important;
    }

    .categories-empty-icon {
        color: #00ff88 !important;
        font-size: 4rem !important;
        margin-bottom: 1.5rem;
    }

    .categories-empty-title {
        color: #fff !important;
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .categories-empty-text {
        color: #b0b0ff !important;
        font-size: 1rem;
        margin-bottom: 2rem;
    }

    .categories-empty-btn {
        background: linear-gradient(135deg, #00ff88, #00ffff) !important;
        color: #000 !important;
        border: none !important;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
    }

    .categories-empty-btn:hover {
        background: linear-gradient(135deg, #00ffff, #00ff88) !important;
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
        color: #000 !important;
    }

    /* Search Styles */
    .search-container {
        position: relative;
        display: flex;
        align-items: center;
        background: rgba(26, 26, 46, 0.8);
        border: 2px solid #00ff88;
        border-radius: 0.75rem;
        padding: 0.5rem;
        box-shadow: 0 0 15px rgba(0, 255, 136, 0.2);
        transition: all 0.3s ease;
    }

    .search-container:focus-within {
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.4);
        border-color: #00ffff;
    }

    .search-input {
        background: transparent !important;
        border: none !important;
        color: #fff !important;
        padding: 0.5rem 1rem;
        width: 250px;
        font-size: 0.95rem;
        outline: none;
    }

    .search-input::placeholder {
        color: #b0b0ff !important;
        opacity: 0.8;
    }

    .search-input:focus {
        box-shadow: none !important;
    }

    .search-btn {
        background: linear-gradient(135deg, #00ff88, #00ffff) !important;
        border: none !important;
        color: #000 !important;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        margin-left: 0.5rem;
        transition: all 0.3s ease;
    }

    .search-btn:hover {
        background: linear-gradient(135deg, #00ffff, #00ff88) !important;
        transform: translateY(-1px);
        box-shadow: 0 0 10px rgba(0, 255, 136, 0.4);
        color: #000 !important;
    }

    .search-btn:focus {
        box-shadow: 0 0 10px rgba(0, 255, 136, 0.4) !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
        
        .d-flex.align-items-center.gap-3 {
            flex-direction: column;
            gap: 1rem !important;
        }
        
        .search-container {
            width: 100%;
            max-width: 300px;
        }
        
        .search-input {
            width: 100%;
        }
        
        .btn-group {
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .btn-group .btn {
            margin-right: 0;
            width: 100%;
        }
        
        .category-icon {
            width: 35px;
            height: 35px;
            font-size: 0.9rem;
        }
        
        .categories-empty-state {
            padding: 2rem 1rem !important;
        }
        
        .categories-empty-icon {
            font-size: 3rem !important;
        }
    }
</style>
